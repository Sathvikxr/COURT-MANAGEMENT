# ==============================================================================
# NyayaDesk: Integrated Court Management System - Environment Configuration
# Copy this file to .env and configure the variables for your deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & SECURITY
# ------------------------------------------------------------------------------
# Application environment: 'production' enforces strict security headers,
# HTTPS-only cookie flags, and disables Flask debug error traces.
FLASK_ENV=development

# Secret key used for signing session cookies, flash messages, and CSRF tokens.
# IN PRODUCTION: Generate a cryptographically secure 64-char key (e.g., openssl rand -hex 32).
SECRET_KEY=nyayadesk-judicial-session-secret-2026-change-in-production

# Web server port (run.py entrypoint)
PORT=5000

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI LAYER (DUAL-MODE ARCHITECTURE)
# ------------------------------------------------------------------------------
# Gemini API Key: If provided and valid, NyayaDesk operates in LIVE GEMINI mode.
# If left blank, offline, or invalid, the app automatically runs in OFFLINE DEMO
# mode using rule-based judicial heuristics, TF-IDF vector search, and local FAQs.
GEMINI_API_KEY=

# Model identifier for text summaries, order drafting, structured JSON extraction, and RAG
GEMINI_MODEL=gemini-2.5-flash

# Model identifier for semantic document and precedent embeddings
GEMINI_EMBED_MODEL=text-embedding-004

# Model identifier for audio minutes transcription
GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. AI RELIABILITY, RATE LIMITING & COST GOVERNANCE
# ------------------------------------------------------------------------------
# Sliding-window request rate limit per authenticated user (requests per minute)
AI_USER_RATE_LIMIT=20

# Global sliding-window request rate limit across all court users (requests per minute)
AI_GLOBAL_RATE_LIMIT=100

# Daily hard cap on upstream LLM requests. When exhausted, seamlessly fails over to Demo mode.
AI_DAILY_REQUEST_CAP=500

# Emergency Kill Switch ('true' disables all live AI calls and forces offline demo mode)
AI_KILL_SWITCH=false

# ------------------------------------------------------------------------------
# 4. TELEPHONY & NOTIFICATION GATEWAYS (SMS / WHATSAPP)
# ------------------------------------------------------------------------------
# Optional Twilio credentials for live SMS/WhatsApp dispatch.
# If omitted or invalid, automated notices seamlessly route to the DEMO gateway.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
